# Vite embeds VITE_* values into the bundle at BUILD time. Set these in the
# Vercel project (Settings -> Environment Variables) and REDEPLOY after any
# change — editing them does not affect an already-built deployment.
#
# Backend base URL: origin only — no trailing slash, no path (the API has no
# /api/v1 prefix; the client calls /auth/login, /boards, ...).
VITE_API_BASE_URL=https://syncboard-api-p0dm.onrender.com
VITE_LIVEBLOCKS_PUBLIC_KEY=pk_prod_xxxxxxxx
