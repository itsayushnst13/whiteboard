# Copy to frontend/.env for local (non-Docker) development.

VITE_API_BASE_URL=http://localhost:8000

# Get a free public API key from https://liveblocks.io/dashboard/apikeys
# (use a pk_dev_... key for local development, pk_prod_... in production).
# Real-time sync/multiplayer will not work until this is set.
VITE_LIVEBLOCKS_PUBLIC_KEY=
