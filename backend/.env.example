# Copy to backend/.env for local (non-Docker) development.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

PROJECT_NAME=SyncBoard
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+asyncpg://syncboard:syncboard@localhost:5432/syncboard
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# Secret used to sign JWT access tokens — generate a real random value for
# any non-local environment, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
