# Copy this file to `.env` in the repo root before running `docker compose up`.
# Per-service defaults live in backend/.env.example and frontend/.env.example —
# this file only covers values docker-compose.yml itself interpolates.

# ---- Postgres ----
POSTGRES_USER=syncboard
POSTGRES_PASSWORD=syncboard
POSTGRES_DB=syncboard
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend ----
BACKEND_PORT=8000

# ---- Frontend ----
FRONTEND_PORT=5173

# Public API key for real-time collaboration (https://liveblocks.io/dashboard/apikeys).
# Only interpolated into the frontend container here; for `make frontend-dev`
# (running outside Docker) set it in frontend/.env instead.
VITE_LIVEBLOCKS_PUBLIC_KEY=
